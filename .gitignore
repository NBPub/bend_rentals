# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Per-run dated copies of the CSV. The published history lives in git: the
# scheduled workflow commits data/listings.csv, so `git log` is the record.
data/snapshots/

# The geocode cache and the listings CSV are committed deliberately: the
# scheduled run rewrites both, and the cache means a clone geocodes nothing.
# Nothing else in data/ or cache/ is, apart from the folder READMEs.
data/*
!data/listings.csv
!data/README.md
cache/*
!cache/geocode.json
!cache/README.md

# Local run output
run.log
map.html

# OS
Thumbs.db
desktop.ini
.DS_Store
